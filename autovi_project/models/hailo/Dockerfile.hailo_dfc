# Dockerfile for Hailo Dataflow Compiler (DFC) Environment
# Target Architecture: Hailo-8 (26 TOPS) for Raspberry Pi AI HAT+
# Base OS: Ubuntu 22.04 LTS (x86_64)
# Python: 3.10.12 (Standard Ubuntu 22.04 LTS Python)

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# 1. Install System Prerequisites
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-dev \
    python3-venv \
    graphviz \
    libgraphviz-dev \
    git \
    wget \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# 2. Upgrade pip and install baseline dependencies
RUN pip3 install --no-cache-dir --upgrade pip setuptools wheel
RUN pip3 install --no-cache-dir \
    numpy==1.23.5 \
    scipy>=1.10.0 \
    onnx==1.15.0 \
    onnxruntime==1.16.3 \
    opencv-python-headless \
    pillow

# 3. Install Proprietary Hailo Dataflow Compiler
# Hailo Dataflow Compiler wheel is login-gated and must be downloaded from:
# https://hailo.ai/developer-zone/software-downloads/
# Recommended version: hailo_dataflow_compiler-3.28.0-py3-none-linux_x86_64.whl
# (or 3.29.0 matching Raspberry Pi OS hailo-all HailoRT v4.17/v4.18)
COPY hailo_dataflow_compiler-*.whl /tmp/
RUN pip3 install --no-cache-dir /tmp/hailo_dataflow_compiler-*.whl && rm -f /tmp/hailo_dataflow_compiler-*.whl

# 4. Entrypoint
COPY compile_hef.sh /workspace/compile_hef.sh
COPY compile_hailo_dfc.py /workspace/compile_hailo_dfc.py
COPY wideresnet50_patchcore.alls /workspace/wideresnet50_patchcore.alls
RUN chmod +x /workspace/compile_hef.sh /workspace/compile_hailo_dfc.py

ENTRYPOINT ["/workspace/compile_hef.sh"]
